{
  "equations": [
    {
      "id": "eq_mvnrkqa17yyq",
      "name": "Viscosity",
      "author": "",
      "year": "",
      "eqNumber": "",
      "source": "",
      "archetype": "function",
      "latex": "\\mu(T) = \\mu_0 \\exp\\left(\\frac{B}{T} - \\frac{B}{T_0}\\right)",
      "outputs": [
        "\\mu"
      ],
      "inputs": [
        "\\mu_0",
        "B",
        "T_0"
      ],
      "loopMeta": "",
      "assumptions": "",
      "ioAuto": true,
      "typeAuto": true,
      "unitCheck": true,
      "condition": ""
    },
    {
      "id": "eq_mvnrkqa102kz",
      "name": "Reynolds number",
      "author": "",
      "year": "",
      "eqNumber": "",
      "source": "",
      "archetype": "explicit",
      "latex": "R_e = \\frac{\\rho u D}{\\mu(T)}",
      "outputs": [
        "R_e"
      ],
      "inputs": [
        "\\rho",
        "u",
        "D",
        "\\mu",
        "T"
      ],
      "loopMeta": "",
      "assumptions": "",
      "ioAuto": true,
      "typeAuto": true,
      "unitCheck": true,
      "condition": ""
    },
    {
      "id": "eq_mvnrkqa167bv",
      "name": "Laminar friction",
      "author": "",
      "year": "",
      "eqNumber": "",
      "source": "",
      "archetype": "explicit",
      "latex": "f = \\frac{64}{R_e}",
      "outputs": [
        "f"
      ],
      "inputs": [
        "R_e"
      ],
      "loopMeta": "",
      "assumptions": "",
      "ioAuto": true,
      "typeAuto": true,
      "unitCheck": true,
      "condition": "R_e < 2300"
    },
    {
      "id": "eq_mvnrkqa1bign",
      "name": "Colebrook",
      "author": "",
      "year": "",
      "eqNumber": "",
      "source": "",
      "archetype": "implicit",
      "latex": "\\frac{1}{\\sqrt{f}} = -2 \\log_{10}\\left(\\frac{k_s}{3.7 D} + \\frac{2.51}{R_e \\sqrt{f}}\\right)",
      "outputs": [
        "f"
      ],
      "inputs": [
        "k_s",
        "D",
        "R_e"
      ],
      "loopMeta": "method = newton, tol = 1e-12, max_iter = 50, min = 1e-4",
      "assumptions": "",
      "ioAuto": true,
      "typeAuto": true,
      "unitCheck": true,
      "condition": "\\text{otherwise}"
    },
    {
      "id": "eq_mvnrkqa16fg3",
      "name": "Pressure drop",
      "author": "",
      "year": "",
      "eqNumber": "",
      "source": "",
      "archetype": "explicit",
      "latex": "\\Delta p = f \\frac{L}{D} \\frac{\\rho u^2}{2}",
